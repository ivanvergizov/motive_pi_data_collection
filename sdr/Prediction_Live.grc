- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):  # other base classes\
      \ are basic_block, decim_block, interp_block\n    \"\"\"Embedded Python Block\
      \ example - a simple multiply const\"\"\"\n\n    def __init__(self, min_power_threshold=0,\
      \ n_transmitters=2):  # only default arguments here\n        \"\"\"arguments\
      \ to this function show up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Prediction Block',   # will show up in\
      \ GRC\n            in_sig=[np.float32] * int(n_transmitters),  \n          \
      \  out_sig=[np.float32]\n        )\n        \n        # if an attribute with\
      \ the same name as a parameter is found,\n        # a callback is registered\
      \ (properties work, too).\n        self.min_power_threshold = min_power_threshold\n\
      \        self.n_transmitters = int(n_transmitters)\n\t\n    def work(self, input_items,\
      \ output_items):\n  \n    \tfor i in range(len(input_items[0])):\n    \t\n \
      \   \t\tpowers = [] \n    \t\tfor ch in range(self.n_transmitters): \n    \t\
      \t\tpowers.append(input_items[ch][i])\n    \t\tpowers = np.array(powers)\n \
      \   \t\tif np.max(powers) < self.min_power_threshold:\n    \t\t\toutput_items[0][i]\
      \ = -1\n    \t\telse:\n    \t\t\toutput_items[0][i] = float(np.argmax(powers))\n\
      \    \t\t\t\n    \treturn len(output_items[0])\n    \t\n        \n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    min_power_threshold: 8e-7
    minoutbuf: '0'
    n_transmitters: '2'
  states:
    _io_cache: ('Prediction Block', 'blk', [('min_power_threshold', '0'), ('n_transmitters',
      '2')], [('0', 'float', 1), ('1', 'float', 1)], [('0', 'float', 1)], 'Embedded
      Python Block example - a simple multiply const', ['min_power_threshold', 'n_transmitters'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1056, 408.0]
    rotation: 0
    state: true
